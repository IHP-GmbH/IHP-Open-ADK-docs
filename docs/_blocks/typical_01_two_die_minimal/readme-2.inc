.. code-block:: bash

    S=/opt/adk-tools/staging
    py=/opt/adk-tools/venv/bin/python3
    SRC=/examples/typical_01_two_die_minimal
    EX=/work/typical_01_two_die_minimal
    OPERATOR=reviewer
    PADS=$S/chiplet-flow/ip/bondpad_70x70_novias_cf/gds/bondpad_70x70_novias.gds
    export CHIPLET_FLOW_THREAD_CAP=2
    RUN=

    if [ ! -f $SRC/system.chiplet ]; then
      echo "STOP: no $SRC/system.chiplet: start the container with run.sh --examples"
    else
      mkdir -p $EX/runs $EX/dies
      [ -e $EX/inputs ] || { cp -r $SRC/inputs $EX/ && chmod -R a-w $EX/inputs; }
      [ -e $EX/admission.json ] || cp $SRC/admission.json $EX/
      if ! (cd $EX/inputs && sha256sum --quiet --strict -c $SRC/inputs/IDENTITY.sha256) ||
         ! cmp -s $SRC/admission.json $EX/admission.json; then
        echo "STOP: $EX is not what $SRC holds"
      else
        for F in PAD_FRAME_L PAD_FRAME_R; do
          if [ -f $EX/dies/$F/pins.json ]; then echo "$F: written earlier"; else
            chiplet-die-flow pad-frame --spec $EX/inputs/frames/$F.frame.json --pad-gds $PADS \
              --pdk-root "$ADK_NIX_SG13G2_PDK" --out $EX/dies/$F; echo "pad-frame $F exit=$?"
          fi
          $py -c 'import json, sys; p = json.load(open(sys.argv[1]))
    print(sys.argv[2] + ":", " ".join(r["name"] for r in p["pins"]))' $EX/dies/$F/pins.json $F
        done
      fi
    fi
