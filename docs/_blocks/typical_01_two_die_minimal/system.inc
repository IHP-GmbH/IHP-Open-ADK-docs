.. code-block:: yaml

    # Typical application 1: two pad frames side by side on an IntM4TM2 carrier.
    # The carrier size, the die positions and the edges are left open: packaging-flow place writes them.
    format_version: "1.4"
    # The run finalizes this file; nothing is signed off from the file itself.
    _metadata:
      finalize_required: true
      finalizer: "packaging-flow run"
    assembly:
      name: cf_typical_01_two_die_minimal
      description: "Two ihp-sg13g2 pad frames, stand-ins for dies not designed yet, flipped onto an IntM4TM2 carrier: four die-to-die lanes, two rails, six wire-bond pads"
      units: um
    # The carrier technology's adapter.
    interposer:
      adapter: intm4tm2
    system:
      # No size: place chooses one that holds the dies with their margins.
      carrier: {technology: intm4tm2, top_cell: CF_CARRIER}
      # No at and no rotation: place chooses them. A frame is placed only under an admission, the file named here.
      dies:
        - {id: U1, die: dies/PAD_FRAME_L, method: cupillar_opt1, thickness: 750, admission: admission.json}
        - {id: U2, die: dies/PAD_FRAME_R, method: cupillar_opt1, thickness: 750, admission: admission.json}
      # One carrier net per lane, pad to pad, named.
      links:
        - {a: "U1.d2d[0]", b: "U2.d2d[0]", net: lane0}
        - {a: "U1.d2d[1]", b: "U2.d2d[1]", net: lane1}
        - {a: "U1.d2d[2]", b: "U2.d2d[2]", net: lane2}
        - {a: "U1.d2d[3]", b: "U2.d2d[3]", net: lane3}
      # The carrier ties these pads into one net each. The volts are for the record: no check reads them here, since a frame declares no supply domain.
      rails:
        - {name: VDD, class: power, volts: 1.2, ports: [U1.VDD, U2.VDD]}
        - {name: VSS, class: ground, ports: [U1.VSS, U2.VSS]}
      # One wire-bond pad per pin that leaves the carrier, on the edge place chooses for it.
      external:
        profile: intm4tm2_wire_bond_v0
    # The pins that leave the carrier, on no edge yet: place removes this block and writes each pin's edge under external.
    unplaced:
      pins: ["U1.ext[0]", "U1.ext[1]", "U2.ext[0]", "U2.ext[1]", VDD, VSS]
    flow:
      packaging_flow:
        # The routing technology and the attachment adapter; the checks template names the four checkpoints.
        route: {tech: ihp_sg13g2_intm4tm2_rdl2, interconnect_adapter: ihp_cupillar}
        checks: {template: signoff}
