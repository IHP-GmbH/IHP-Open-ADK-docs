.. From adk-examples e4f43a62b5b9247c32b9fb8983f79b0def8ecb28: typical_01_two_die_minimal/scripts/readme-7-container.sh

.. code-block:: bash

    $py -B -m packaging_flow.cli resume $RUN; echo "resume exit=$?"
    $py -B -m packaging_flow.cli map $RUN; echo "map exit=$?"
    $py -B -m packaging_flow.cli status $RUN; echo "status exit=$?"
    # expected: verify exit=1
    # prints: verify: not every die was built in this run (tier full; built none; admitted U1, U2)
    $py -B -m packaging_flow.cli verify $RUN/run/manifest.json; echo "verify exit=$?"
    $py -B -m packaging_flow.cli review-levels $RUN/run $RUN/review; echo "review-levels exit=$?"
    echo "memory.peak=$(cat /sys/fs/cgroup/memory.peak 2>/dev/null || echo unavailable)"
    # prints: assembly LVS: robust_match 10 nets 22 endpoints 0 findings
    # prints: route: 10 nets routed 0 violations 22 endpoint bodies checked
    # prints: copper: 54 segments 5830 um on TopMetal1 and TopMetal2
    $py -B -c 'import json, sys
    lvs = json.load(open(sys.argv[1] + "/out/reports/assembly_lvs.json"))
    route = json.load(open(sys.argv[1] + "/pnr/route.json"))
    ends = sum(len(n.get("terminal_ids", [])) for n in lvs.get("nets", []))
    print("assembly LVS:", lvs.get("state"), len(lvs.get("nets", [])), "nets", ends, "endpoints",
          len(lvs.get("findings", [])), "findings")
    print("route:", route.get("nets_routed"), "nets routed", route.get("drc_violations"), "violations",
          route.get("endpoint_bodies_checked"), "endpoint bodies checked")
    print("copper:", route.get("segments"), "segments", round(route.get("wirelength_um", 0)), "um on",
          " and ".join(sorted(route.get("layers_used", []))))' $RUN/run
