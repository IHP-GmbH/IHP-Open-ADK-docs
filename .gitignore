# Sphinx build output
docs/_build/
docs/**/*.log
*.log

# Generated by docs/scripts/ during pre_build. Tracked copies exist so the
# CI drift gate can diff them; local rebuilds must not create noise here.
docs/**/__pycache__/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
docs_env/

# LaTeX intermediates from the TikZ figure renderer
docs/_figures/tikz/*.aux
docs/_figures/tikz/*.fdb_latexmk
docs/_figures/tikz/*.fls
docs/_figures/tikz/*.out
docs/_figures/tikz/*.dvi

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

